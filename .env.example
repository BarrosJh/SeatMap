# Servidor
PORT=3000
NODE_ENV=development
TZ=America/Sao_Paulo

# Banco de Dados PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=seatmap_db
DB_USER=seatmap_user
DB_PASSWORD=seatmap_password
DB_POOL_MAX=20
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=5000

# Autenticação JWT
JWT_SECRET=super_secret_jwt_key_seatmap_2026_change_in_prod
JWT_EXPIRATION=15m
JWT_ADMIN_SECRET=super_secret_admin_mfa_jwt_key_seatmap_2026
JWT_ADMIN_EXPIRATION=15m
JWT_MFA_TEMP_SECRET=super_secret_mfa_temp_key_seatmap_2026_change_in_prod
ENCRYPTION_KEY=super_secret_encryption_key_seatmap_2026_change_in_prod

# Probes internas e proxy reverso
INTERNAL_HEALTH_TOKEN=change_in_prod_internal_health_token_32_chars
TRUST_PROXY_HOPS=0

# MFA Settings
MFA_CODE_EXPIRATION_MINUTES=5

# Regras de Negócio Padrão
DEFAULT_WEEKLY_LIMIT=2
DEFAULT_CHECKIN_CUTOFF_TIME=11:00

