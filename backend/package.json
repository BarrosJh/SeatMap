{
  "name": "seatmap-backend",
  "version": "1.0.0",
  "description": "Backend API para SeatMap Internal em Node.js, Express, PostgreSQL e WebSockets nativos",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node src/server.ts",
    "typecheck": "tsc --noEmit",
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "jest --passWithNoTests",
    "test:coverage": "jest --coverage",
    "db:migrate": "node dist/database/migrate.js",
    "db:seed": "node dist/database/seed.js",
    "db:migrate:dev": "ts-node src/database/migrate.ts",
    "db:seed:dev": "ts-node src/database/seed.ts"
  },
  "dependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/luxon": "^3.4.2",
    "@types/node": "^20.12.12",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.11.6",
    "@types/ws": "^8.5.10",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "luxon": "^3.4.4",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.11.5",
    "rimraf": "^5.0.7",
    "typescript": "^5.4.5",
    "ws": "^8.17.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2"
  },
  "overrides": {
    "tar": "^7.5.22",
    "qs": "^6.16.0",
    "uuid": "^11.1.1"
  }
}
