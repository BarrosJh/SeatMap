# ========================================================
# SEATMAP BACKEND - VARIÁVEIS DE AMBIENTE
# ========================================================

# Configurações do Servidor
PORT=3000
NODE_ENV=development

# Conexão com o Banco de Dados PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nbx_assentos
# Ou variáveis separadas:
# PGUSER=postgres
# PGPASSWORD=postgres
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=nbx_assentos

# Chaves Secretas JWT
JWT_SECRET=super_secret_jwt_key_seatmap_2026_change_in_prod
JWT_EXPIRATION=1d
JWT_ADMIN_SECRET=super_secret_admin_mfa_jwt_key_seatmap_2026
JWT_ADMIN_EXPIRATION=2h

# ========================================================
# CONFIGURAÇÃO DE E-MAIL (SMTP)
# ========================================================
# Se estas variáveis não forem preenchidas, o sistema opera em
# modo de simulação/log estruturado sem travar a aplicação.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu-email@empresa.com.br
SMTP_PASS=sua-senha-de-aplicativo-ou-token
EMAIL_FROM="SeatMap Corporativo" <nao-responda@empresa.com.br>

# Exemplos de Provedores Populares:
#
# 1. GMAIL / GOOGLE WORKSPACE:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=seu_email@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx  (Senha de App gerada na Conta Google > Segurança > Senhas de app)
#
# 2. MICROSOFT 365 / OUTLOOK:
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=seu_email@empresa.com.br
# SMTP_PASS=sua_senha_ou_app_password
#
# 3. AMAZON SES:
# SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=AKIAxxxxxxxxxxxx
# SMTP_PASS=BJxxxxxxxxxxxxxxxxxxxxxxxx
#
# 4. SENDGRID / RESEND:
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=SG.xxxxxxxxxxxxxxxx
#
# 5. MAILTRAP (Ambiente Seguro de Testes):
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USER=seu_user_mailtrap
# SMTP_PASS=sua_senha_mailtrap
