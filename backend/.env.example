# Exemplo de variáveis de ambiente para desenvolvimento local.
# NÃO use estes valores em produção; troque sempre por segredos reais.
# O arquivo .env real deve ser mantido fora do repositório.

PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_NAME=seatmap_db
DB_USER=seatmap_user
DB_PASSWORD=change_me_strong_db_password

JWT_SECRET=change_me_strong_random_jwt_secret_32_chars
JWT_EXPIRATION=15m

JWT_ADMIN_SECRET=change_me_strong_random_admin_secret_32_chars
JWT_ADMIN_EXPIRATION=15m

JWT_MFA_TEMP_SECRET=change_me_strong_random_mfa_secret_32_chars
ENCRYPTION_KEY=change_me_strong_32char_encryption_key

# Probes internas e proxy reverso
INTERNAL_HEALTH_TOKEN=change_me_strong_internal_health_token_32_chars
TRUST_PROXY_HOPS=0

# Somente homologacao: amplia o limite global durante testes de carga.
# Mantenha false em desenvolvimento normal, staging operacional e producao.
LOAD_TEST_MODE=false
LOAD_TEST_RATE_LIMIT_MAX=10000

# Burst de login por IP corporativo; a protecao por conta continua em 5/15 min.
AUTH_IP_RATE_LIMIT_MAX=50
GLOBAL_RATE_LIMIT_MAX=900

SCIM_BEARER_TOKEN=change_me_if_scim_is_used
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:8080
